{
  "published_at": "2026-03-06T00:00:00Z",
  "release": {
    "version": "1.0.0",
    "channel": "stable"
  },
  "capability": {
    "id": "primary",
    "kind": "compute",
    "scheme": "sandbox",
    "title": "Remote Sandbox",
    "summary": "Create and operate remote sandboxes through a provider-authored ARC runtime.",
    "invocation": {
      "mode": "request_reply",
      "method": "RAW",
      "path": "/sandbox",
      "stream": {
        "operations": [
          "open",
          "data",
          "resize",
          "close",
          "exit",
          "error"
        ],
        "tty": true,
        "encoding": "text",
        "input": {
          "type": "text",
          "description": "Terminal input"
        },
        "output": {
          "type": "text",
          "description": "Terminal output"
        }
      }
    },
    "examples": [
      "new alpine",
      "shell sb-alpine"
    ]
  },
  "interfaces": {
    "cli": {
      "version": 1,
      "namespace": "sandbox",
      "summary": "Operate remote sandboxes through the ARC stream runtime",
      "commands": [
        {
          "path": [
            "new"
          ],
          "summary": "Create a new sandbox",
          "args": [
            {
              "name": "image",
              "kind": "positional",
              "required": true,
              "description": "Container image to provision"
            }
          ],
          "input": {
            "source": "template",
            "template": "NEW {{image}}"
          }
        },
        {
          "path": [
            "shell"
          ],
          "summary": "Attach to a sandbox shell",
          "args": [
            {
              "name": "sandbox_id",
              "kind": "positional",
              "required": true,
              "description": "Sandbox id returned by sandbox new"
            }
          ],
          "input": {
            "source": "template",
            "template": "SHELL {{sandbox_id}}"
          },
          "invoke": {
            "mode": "stream",
            "method": "RAW",
            "path": "/sandbox/shell",
            "stream": {
              "tty": true,
              "operations": [
                "open",
                "data",
                "resize",
                "close",
                "exit",
                "error"
              ],
              "encoding": "text"
            }
          },
          "examples": [
            "sb-alpine"
          ]
        }
      ]
    }
  }
}
