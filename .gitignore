# What the Go build writes. `go build ./cmd/arc` at the root writes /arc, and
# `go build ./apps/<name>/cmd/arc-<name>` writes /arc-<name>.
/bin/
/arc
/arc-*

# The release workflow writes its tarballs here. Git must not see them, or each
# later build of the loop stamps vcs.modified=true.
/dist/

# Temporary files, for example, from tests.
/tmp/

# Identity keyrings (contain secrets)
.arc/

# Repository instructions must be shared even when a global ignore hides them.
!/AGENTS.md

# Project skills are tracked even though the global ignore hides .claude/
!.claude/
.claude/*
!.claude/skills/
