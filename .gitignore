# What the Go build writes. `go build ./cmd/<name>` at the root writes /<name>.
/bin/
/arc-legacy
/arc

# Temporary files, for example, from tests.
/tmp/

# Machine-local Docker Compose settings.
/.env

# Identity keyrings (contain secrets)
.arc/

# Project skills are tracked even though the global ignore hides .claude/
!.claude/
.claude/*
!.claude/skills/
