{
  "published_at": "2026-03-06T00:00:00Z",
  "release": {
    "version": "1.0.0",
    "channel": "stable"
  },
  "capability": {
    "id": "primary",
    "kind": "service",
    "scheme": "rest",
    "title": "Users API",
    "summary": "Manage users through a provider-authored ARC exec runtime.",
    "invocation": {
      "method": "RAW",
      "path": "/"
    }
  },
  "interfaces": {
    "cli": {
      "version": 1,
      "namespace": "users",
      "summary": "Manage users through the provider-authored ARC capability",
      "commands": [
        {
          "path": [
            "get"
          ],
          "summary": "List users",
          "input": {
            "source": "template",
            "template": "GET /users"
          }
        },
        {
          "path": [
            "add"
          ],
          "summary": "Create a user",
          "args": [
            {
              "name": "name",
              "kind": "option",
              "flag": "--name",
              "type": "string",
              "required": true,
              "description": "User display name"
            },
            {
              "name": "email",
              "kind": "option",
              "flag": "--email",
              "type": "string",
              "required": true,
              "description": "User email address"
            }
          ],
          "input": {
            "source": "template",
            "template": "POST /users {\"name\":\"{{name}}\",\"email\":\"{{email}}\"}"
          },
          "examples": [
            "--name Ada --email ada@example.com"
          ]
        }
      ]
    }
  }
}
