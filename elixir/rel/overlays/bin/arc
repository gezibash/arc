#!/bin/sh
# User-facing entry point of the release. Boots the bundled Erlang runtime
# and runs `Arc.CLI.main/1` with the given arguments, so `arc relay`,
# `arc listen`, `arc mcp`, and every other command work from one tarball.
# `bin/arc_runtime` is the generated release control script; this wrapper
# resolves symlinks first so `ln -s .../bin/arc /usr/local/bin/arc` works.
set -e

readlink_f () {
  cd "$(dirname "$1")" > /dev/null
  filename="$(basename "$1")"
  if [ -h "$filename" ]; then
    readlink_f "$(readlink "$filename")"
  else
    echo "$(pwd -P)/$filename"
  fi
}

SELF="$(readlink_f "$0")"
RELEASE_ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"

if [ "$1" = "service" ] && [ "$2" = "start" ]; then
  if [ "$2" != "start" ] || [ "$3" != "--config" ] || [ -z "$4" ] || [ -n "$5" ]; then
    echo "usage: arc service start --config ABS_JSON_PATH" >&2
    exit 2
  fi

  case "$4" in
    /*) ;;
    *)
      echo "error: service config must be an absolute path" >&2
      exit 2
      ;;
  esac

  # `start` uses the generated release control script and its committed
  # start_erl.data selection. Do not infer a version directory here.
  # Updates are administered through the private Unix socket. Do not expose
  # distributed Erlang or rely on a cookie shipped inside a release archive.
  ARC_SERVICE_CONFIG="$4" RELEASE_DISTRIBUTION=none exec "$RELEASE_ROOT/bin/arc_runtime" start
fi

exec "$RELEASE_ROOT/bin/arc_runtime" eval 'Arc.CLI.main(System.argv())' "$@"
