#!/bin/bash
# Prepare the exec citizen after a wake. See docs/exec/SPEC.md, section 10.3.
#
# A live lease "arc" proves that the Sprite did not pause since the last run,
# so the running `arc serve` still has its relay connection. Without the lease,
# the old relay connection is gone: start a new `arc serve`.
#
# Exit 0: the citizen is ready. Exit 1: the relay has no announcement.
# Stdout stays empty. Callers can use this script in an SSH ProxyCommand.
set -u

here=$(cd "$(dirname "$0")/.." && pwd)
# citizen.env sets ARC_KEY, ARC_RELAY, ARC_RELAY_PUBKEY, EXEC_CONFIG, and
# CITIZEN_PUBLIC_KEY.
set -a
. "$here/citizen.env"
set +a
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

tasks() { /.sprite/bin/sprite-env curl -sf "$@" >/dev/null 2>&1; }
log() { echo "$(date -u +%FT%T.%3NZ) citizen-up: $*" >> "$here/citizen-up.log"; }

if ! tasks -X POST /v1/tasks -d '{"name":"arc","expire":120}'; then
  tasks -X PUT /v1/tasks/arc -d '{"expire":120}'
  log "lease was live, kept arc serve"
  exit 0
fi

pidfile="$here/serve.pid"
if [ -f "$pidfile" ]; then
  kill -TERM -- "-$(cat "$pidfile")" 2>/dev/null
fi
setsid "$here/sprite/serve" >> "$here/serve.log" 2>&1 < /dev/null &
echo $! > "$pidfile"
log "started arc serve pid $!"

deadline=$((SECONDS + 20))
while [ $SECONDS -lt $deadline ]; do
  if env -u ARC_KEY arc info "$CITIZEN_PUBLIC_KEY" primary >/dev/null 2>&1; then
    log "ready"
    exit 0
  fi
  sleep 0.3
done

tasks -X DELETE /v1/tasks/arc
log "no announcement after 20 seconds"
exit 1
