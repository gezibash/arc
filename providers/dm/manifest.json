{
  "published_at": "2026-09-14T00:00:00Z",
  "release": {
    "version": "0.1.0",
    "channel": "stable"
  },
  "capability": {
    "id": "primary",
    "kind": "data",
    "scheme": "dm",
    "title": "Direct Messages",
    "summary": "Sealed direct messages with a persistent inbox. Bodies are sealed to the reader before they leave the sender. The host stores ciphertext only.",
    "invocation": {
      "method": "RAW",
      "path": "/"
    },
    "examples": [
      "inbox --unread",
      "read 01J7Q0X5R8M4N6P2T9V1W3Y5Z7",
      "whoami"
    ]
  },
  "interfaces": {
    "cli": {
      "version": 1,
      "namespace": "dm",
      "commands": [
        {
          "path": [],
          "summary": "Home: every conversation with unread count and the latest message.",
          "args": [
            {
              "name": "limit",
              "kind": "option",
              "flag": "--limit",
              "type": "string",
              "required": false,
              "description": "Max conversations, default 50"
            }
          ],
          "input": {
            "source": "template",
            "template": "conversations --limit {{limit|json}}"
          },
          "output": {
            "filter": [
              "open",
              "petnames",
              "preview:60"
            ]
          }
        },
        {
          "path": [
            "conversations"
          ],
          "summary": "List conversations: peer, last id, last time, unread, muted, latest message.",
          "args": [
            {
              "name": "limit",
              "kind": "option",
              "flag": "--limit",
              "type": "string",
              "required": false,
              "description": "Max conversations, default 50"
            }
          ],
          "input": {
            "source": "template",
            "template": "conversations --limit {{limit|json}}"
          },
          "output": {
            "filter": [
              "open",
              "petnames",
              "preview:60"
            ]
          },
          "examples": [
            "",
            "--limit 10"
          ]
        },
        {
          "path": [
            "send"
          ],
          "summary": "Send a message to a peer. The body is the text argument, or --file, or stdin. It is sealed to the peer and to you before it leaves this machine.",
          "args": [
            {
              "name": "peer",
              "kind": "positional",
              "required": true,
              "description": "Recipient: petname, short name, key prefix, or 64 hex"
            },
            {
              "name": "text",
              "kind": "positional",
              "required": false,
              "variadic": true,
              "description": "Message text. Omit to read --file or stdin."
            },
            {
              "name": "reply_to",
              "kind": "option",
              "flag": "--reply-to",
              "type": "string",
              "required": false,
              "description": "Id of the message this replies to"
            },
            {
              "name": "file",
              "kind": "option",
              "flag": "--file",
              "type": "string",
              "required": false,
              "description": "Read the body from this file"
            }
          ],
          "input": {
            "source": "stdin",
            "template": "send {{peer|pubkey}} --reply-to {{reply_to|json}}",
            "seal_to": [
              "peer",
              "me"
            ],
            "body": "text",
            "file": "file"
          },
          "examples": [
            "jolly-volta \"Looks right. One nit on section 3.\"",
            "jolly-volta --file review.md",
            "jolly-volta --reply-to 01J7Q0X5R8M4N6P2T9V1W3Y5Z7 \"Yes.\"",
            "jolly-volta < note.md"
          ]
        },
        {
          "path": [
            "inbox"
          ],
          "summary": "List messages in your mailbox: id, direction, peer, time, sealed bytes.",
          "args": [
            {
              "name": "unread",
              "kind": "option",
              "flag": "--unread",
              "type": "boolean",
              "required": false,
              "description": "Only unread inbound messages"
            },
            {
              "name": "since",
              "kind": "option",
              "flag": "--since",
              "type": "string",
              "required": false,
              "description": "Only ids greater than this ULID"
            },
            {
              "name": "limit",
              "kind": "option",
              "flag": "--limit",
              "type": "string",
              "required": false,
              "description": "Max messages, default 50"
            }
          ],
          "input": {
            "source": "template",
            "template": "inbox --unread \"{{unread}}\" --since {{since|json}} --limit {{limit|json}}"
          },
          "examples": [
            "",
            "--unread",
            "--since 01J7Q0X5R8M4N6P2T9V1W3Y5Z7"
          ],
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "thread"
          ],
          "summary": "List both directions of one thread in time order.",
          "args": [
            {
              "name": "peer",
              "kind": "positional",
              "required": true,
              "description": "Recipient: petname, short name, key prefix, or 64 hex"
            },
            {
              "name": "since",
              "kind": "option",
              "flag": "--since",
              "type": "string",
              "required": false,
              "description": "Only ids greater than this ULID"
            },
            {
              "name": "limit",
              "kind": "option",
              "flag": "--limit",
              "type": "string",
              "required": false,
              "description": "Max messages, default 50"
            }
          ],
          "input": {
            "source": "template",
            "template": "thread {{peer|pubkey}} --since {{since|json}} --limit {{limit|json}}"
          },
          "examples": [
            "jolly-volta"
          ],
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "read"
          ],
          "summary": "Read one message. Marks an inbound message as read.",
          "args": [
            {
              "name": "id",
              "kind": "positional",
              "required": true,
              "description": "Message id"
            }
          ],
          "input": {
            "source": "template",
            "template": "read {{id}}"
          },
          "output": {
            "filter": [
              "open",
              "petnames"
            ]
          },
          "examples": [
            "01J7Q0X5R8M4N6P2T9V1W3Y5Z7"
          ]
        },
        {
          "path": [
            "ack"
          ],
          "summary": "Mark inbound messages as read without reading them.",
          "args": [
            {
              "name": "ids",
              "kind": "positional",
              "required": true,
              "description": "Message ids",
              "variadic": true
            }
          ],
          "input": {
            "source": "template",
            "template": "ack {{ids}}"
          }
        },
        {
          "path": [
            "status"
          ],
          "summary": "Show delivered and read receipts for a message you sent.",
          "args": [
            {
              "name": "id",
              "kind": "positional",
              "required": true,
              "description": "Message id"
            }
          ],
          "input": {
            "source": "template",
            "template": "status {{id}}"
          },
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "archive"
          ],
          "summary": "Hide messages from inbox. They stay in thread.",
          "args": [
            {
              "name": "ids",
              "kind": "positional",
              "required": true,
              "description": "Message ids",
              "variadic": true
            }
          ],
          "input": {
            "source": "template",
            "template": "archive {{ids}}"
          }
        },
        {
          "path": [
            "block"
          ],
          "summary": "Refuse future messages from a peer.",
          "args": [
            {
              "name": "peer",
              "kind": "positional",
              "required": true,
              "description": "Recipient: petname, short name, key prefix, or 64 hex"
            }
          ],
          "input": {
            "source": "template",
            "template": "block {{peer|pubkey}}"
          },
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "unblock"
          ],
          "summary": "Reverse block.",
          "args": [
            {
              "name": "peer",
              "kind": "positional",
              "required": true,
              "description": "Recipient: petname, short name, key prefix, or 64 hex"
            }
          ],
          "input": {
            "source": "template",
            "template": "unblock {{peer|pubkey}}"
          },
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "blocked"
          ],
          "summary": "List blocked keys.",
          "input": {
            "source": "template",
            "template": "blocked"
          },
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "whoami"
          ],
          "summary": "Print your mailbox address.",
          "input": {
            "source": "template",
            "template": "whoami"
          },
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "mute"
          ],
          "summary": "Stop counting a peer as unread. Messages still arrive.",
          "args": [
            {
              "name": "peer",
              "kind": "positional",
              "required": true,
              "description": "Peer: petname, short name, key prefix, or 64 hex"
            }
          ],
          "input": {
            "source": "template",
            "template": "mute {{peer|pubkey}}"
          },
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "unmute"
          ],
          "summary": "Reverse mute.",
          "args": [
            {
              "name": "peer",
              "kind": "positional",
              "required": true,
              "description": "Peer: petname, short name, key prefix, or 64 hex"
            }
          ],
          "input": {
            "source": "template",
            "template": "unmute {{peer|pubkey}}"
          },
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "muted"
          ],
          "summary": "List muted peers.",
          "input": {
            "source": "template",
            "template": "muted"
          },
          "output": {
            "filter": [
              "petnames"
            ]
          }
        },
        {
          "path": [
            "settings"
          ],
          "summary": "Show settings, or set one: settings receipts on|off. With receipts off, senders see delivered but not read.",
          "args": [
            {
              "name": "key",
              "kind": "positional",
              "required": false,
              "description": "receipts"
            },
            {
              "name": "value",
              "kind": "positional",
              "required": false,
              "description": "on or off"
            }
          ],
          "input": {
            "source": "template",
            "template": "settings {{key}} {{value}}"
          },
          "examples": [
            "",
            "receipts off"
          ]
        }
      ]
    }
  }
}
