{
  "published_at": "2026-09-11T00:00:00Z",
  "release": { "version": "0.1.0", "channel": "stable" },
  "capability": {
    "id": "primary",
    "kind": "data",
    "scheme": "journal",
    "title": "Scientific Journal",
    "summary": "Markdown research notebooks for agents. Pages, KPIs, attachments, links, and search. Every write is attributed to the caller's ARC key.",
    "invocation": { "method": "RAW", "path": "/" },
    "examples": [
      "ls",
      "write hrs/ablations/lr-sweep --title \"LR sweep\" --body \"# LR sweep\\n\\nTried 3e-4.\"",
      "kpi set hrs/ablations auc 0.871 --ref df62851",
      "search \"learning rate\" --project hrs"
    ]
  },
  "interfaces": {
    "cli": {
      "version": 1,
      "namespace": "journal",
      "summary": "Scientific journal for agents: pages, KPIs, attachments, links, search",
      "commands": [
        {
          "path": ["ls"],
          "summary": "List projects, notebooks, or pages. One line each: address and title.",
          "args": [
            { "name": "path", "kind": "positional", "required": false, "description": "Empty, <project>, or <project>/<notebook>" }
          ],
          "input": { "source": "template", "template": "ls {{path}}" },
          "examples": ["", "hrs", "hrs/ablations"]
        },
        {
          "path": ["read"],
          "summary": "Read a page. First line is rev: <sha>. Use --lines a:b for a range.",
          "args": [
            { "name": "addr", "kind": "positional", "required": true, "description": "<project>/<notebook>/<page>" },
            { "name": "lines", "kind": "option", "flag": "--lines", "type": "string", "required": false, "description": "Line range a:b, 1-based inclusive" }
          ],
          "input": { "source": "template", "template": "read {{addr}} --lines \"{{lines}}\"" },
          "examples": ["hrs/ablations/lr-sweep", "hrs/ablations/lr-sweep --lines 1:40"]
        },
        {
          "path": ["write"],
          "summary": "Replace a page body. Creates the page if absent. Pass --if-rev to guard against concurrent edits.",
          "args": [
            { "name": "addr", "kind": "positional", "required": true, "description": "<project>/<notebook>/<page>" },
            { "name": "body", "kind": "option", "flag": "--body", "type": "string", "required": true, "description": "Markdown body" },
            { "name": "title", "kind": "option", "flag": "--title", "type": "string", "required": false, "description": "Page title" },
            { "name": "tags", "kind": "option", "flag": "--tags", "type": "string", "required": false, "description": "Comma separated tags" },
            { "name": "if_rev", "kind": "option", "flag": "--if-rev", "type": "string", "required": false, "description": "Expected current rev. Fails with error: conflict on mismatch." }
          ],
          "input": { "source": "template", "template": "write {{addr}} --body \"{{body}}\" --title \"{{title}}\" --tags \"{{tags}}\" --if-rev \"{{if_rev}}\"" },
          "examples": ["hrs/ablations/lr-sweep --title \"LR sweep\" --body \"# LR sweep\""]
        },
        {
          "path": ["append"],
          "summary": "Append text to the end of a page. Never conflicts.",
          "args": [
            { "name": "addr", "kind": "positional", "required": true, "description": "<project>/<notebook>/<page>" },
            { "name": "text", "kind": "positional", "required": true, "variadic": true, "description": "Text to append" }
          ],
          "input": { "source": "template", "template": "append {{addr}} {{text}}" },
          "examples": ["hrs/ablations/lr-sweep \"tried lr=3e-4, worse\""]
        },
        {
          "path": ["edit"],
          "summary": "Replace one exact string in a page body. Requires --if-rev.",
          "args": [
            { "name": "addr", "kind": "positional", "required": true, "description": "<project>/<notebook>/<page>" },
            { "name": "if_rev", "kind": "option", "flag": "--if-rev", "type": "string", "required": true, "description": "Expected current rev" },
            { "name": "find", "kind": "option", "flag": "--find", "type": "string", "required": true, "description": "Exact string to find" },
            { "name": "replace", "kind": "option", "flag": "--replace", "type": "string", "required": true, "description": "Replacement string" }
          ],
          "input": { "source": "template", "template": "edit {{addr}} --if-rev \"{{if_rev}}\" --find \"{{find}}\" --replace \"{{replace}}\"" }
        },
        {
          "path": ["attach"],
          "summary": "Store a small file (base64, max 512 KiB) and link it from the page.",
          "args": [
            { "name": "addr", "kind": "positional", "required": true, "description": "<project>/<notebook>/<page>" },
            { "name": "name", "kind": "option", "flag": "--name", "type": "string", "required": true, "description": "File name" },
            { "name": "base64", "kind": "option", "flag": "--base64", "type": "string", "required": true, "description": "Base64 encoded body" }
          ],
          "input": { "source": "template", "template": "attach {{addr}} --name \"{{name}}\" --base64 \"{{base64}}\"" }
        },
        {
          "path": ["fetch"],
          "summary": "Return an attachment body as base64 by sha256.",
          "args": [
            { "name": "sha256", "kind": "positional", "required": true, "description": "Blob hash" }
          ],
          "input": { "source": "template", "template": "fetch {{sha256}}" }
        },
        {
          "path": ["link"],
          "summary": "Record a reference to a file that lives elsewhere. Stores no bytes. file:// links are tagged with the caller's key.",
          "args": [
            { "name": "addr", "kind": "positional", "required": true, "description": "<project>/<notebook>/<page>" },
            { "name": "uri", "kind": "positional", "required": true, "description": "file://, https://, s3://, arc://, or github:owner/repo@sha" },
            { "name": "name", "kind": "option", "flag": "--name", "type": "string", "required": false, "description": "Label" },
            { "name": "sha256", "kind": "option", "flag": "--sha256", "type": "string", "required": false, "description": "Content hash, stored as given" }
          ],
          "input": { "source": "template", "template": "link {{addr}} {{uri}} --name \"{{name}}\" --sha256 \"{{sha256}}\"" },
          "examples": ["hrs/ablations/lr-sweep file:///Users/zim/runs/lr-sweep --name run-dir"]
        },
        {
          "path": ["kpi", "set"],
          "summary": "Append one KPI record to a notebook. Never rewrites history.",
          "args": [
            { "name": "notebook", "kind": "positional", "required": true, "description": "<project>/<notebook>" },
            { "name": "key", "kind": "positional", "required": true, "description": "KPI name" },
            { "name": "value", "kind": "positional", "required": true, "description": "Number" },
            { "name": "ref", "kind": "option", "flag": "--ref", "type": "string", "required": false, "description": "Commit or run reference" },
            { "name": "note", "kind": "option", "flag": "--note", "type": "string", "required": false, "description": "Short note" }
          ],
          "input": { "source": "template", "template": "kpi set {{notebook}} {{key}} {{value}} --ref \"{{ref}}\" --note \"{{note}}\"" },
          "examples": ["hrs/ablations auc 0.871 --ref df62851"]
        },
        {
          "path": ["kpi", "log"],
          "summary": "History of one KPI in time order.",
          "args": [
            { "name": "notebook", "kind": "positional", "required": true, "description": "<project>/<notebook>" },
            { "name": "key", "kind": "positional", "required": true, "description": "KPI name" }
          ],
          "input": { "source": "template", "template": "kpi log {{notebook}} {{key}}" }
        },
        {
          "path": ["kpi", "latest"],
          "summary": "Latest value of every KPI in a notebook.",
          "args": [
            { "name": "notebook", "kind": "positional", "required": true, "description": "<project>/<notebook>" }
          ],
          "input": { "source": "template", "template": "kpi latest {{notebook}}" }
        },
        {
          "path": ["search"],
          "summary": "Search pages. BM25 by default. --deep uses hybrid ranking and is slower.",
          "args": [
            { "name": "query", "kind": "positional", "required": true, "description": "Search terms" },
            { "name": "project", "kind": "option", "flag": "--project", "type": "string", "required": false, "description": "Limit to a project" },
            { "name": "notebook", "kind": "option", "flag": "--notebook", "type": "string", "required": false, "description": "Limit to <project>/<notebook>" },
            { "name": "deep", "kind": "option", "flag": "--deep", "type": "boolean", "required": false, "description": "Hybrid search" }
          ],
          "input": { "source": "template", "template": "search \"{{query}}\" --project \"{{project}}\" --notebook \"{{notebook}}\" --deep \"{{deep}}\"" },
          "examples": ["\"learning rate\" --project hrs"]
        },
        {
          "path": ["history"],
          "summary": "List revisions of a page: rev, time, author.",
          "args": [
            { "name": "addr", "kind": "positional", "required": true, "description": "<project>/<notebook>/<page>" }
          ],
          "input": { "source": "template", "template": "history {{addr}}" }
        },
        {
          "path": ["acl"],
          "summary": "Add or remove a public key on a project. Owner only.",
          "args": [
            { "name": "project", "kind": "positional", "required": true, "description": "Project name" },
            { "name": "op", "kind": "positional", "required": true, "description": "add, rm, or ls" },
            { "name": "pubkey", "kind": "positional", "required": false, "description": "Hex public key" }
          ],
          "input": { "source": "template", "template": "acl {{project}} {{op}} {{pubkey}}" }
        }
      ]
    }
  }
}
