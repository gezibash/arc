{
  "published_at": "2026-09-20T00:00:00Z",
  "release": {"version": "0.1.0", "channel": "stable"},
  "capability": {
    "id": "primary",
    "kind": "compute",
    "scheme": "echo",
    "title": "Echo over ARC",
    "summary": "Answers with the body that it receives.",
    "invocation": {"mode": "request_reply", "method": "ECHO", "path": "/", "request_body": {"max_bytes": 65536}},
    "examples": ["echo+arc://provider/"]
  },
  "interfaces": {
    "cli": {
      "version": 1,
      "namespace": "echo",
      "summary": "Say something to a citizen, and hear it back.",
      "commands": [
        {
          "path": [],
          "summary": "Say something.",
          "args": [{"name": "words", "kind": "positional", "required": true, "variadic": true, "description": "What to say"}],
          "input": {"source": "arg", "name": "words", "join_with": " "}
        },
        {
          "path": ["twice"],
          "summary": "Say something, and name who said it.",
          "args": [
            {"name": "words", "kind": "positional", "required": true, "variadic": true},
            {"name": "from", "kind": "option", "flag": "--from", "type": "string", "required": false}
          ],
          "input": {"source": "template", "template": "{{from}} says {{words}}"}
        }
      ]
    }
  }
}
