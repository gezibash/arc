#!/bin/sh
# Serve the exec provider bundle as a plain process. citizen-up starts it.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
. "$here/citizen.env"
export ARC_HOME ARC_KEY EXEC_CONFIG EXEC_PROVIDER
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
cd "$here"

# After a wake, the network needs a moment. If the relay does not take the
# first announcement and the first watch, a caller waits until the next
# refresh. Wait for the relay before the start.
host=${CITIZEN_RELAY#*://}
host=${host%/}
case $CITIZEN_RELAY in
  wss://*) port=443 ;;
  *) port=80 ;;
esac
case $host in
  *:*) port=${host##*:}; host=${host%:*} ;;
esac
attempt=0
while [ "$attempt" -lt 30 ]; do
  if timeout 2 bash -c "echo > /dev/tcp/$host/$port" 2>/dev/null; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 1
done

exec arc serve "exec://$EXEC_PROVIDER?manifest=$here/manifest.json"
