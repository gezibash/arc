#!/bin/bash
# Write citizen.env and config.json for this bundle. Run it once on the
# citizen machine, from any directory.
#
#   citizen/init --key NAME --relay URL --grant HEX [--grant HEX ...]
#     [--platform sprite|none] [--cwd DIR] [--notify-dm]
#
# --key       the arc identity of the citizen. Make it first with
#             `arc keys gen`.
# --relay     the Nostr relay of the citizen, for example
#             wss://arc-nostr-gezim.fly.dev. init adds it to the identity.
# --grant     a caller key that can run commands. A grant equals a shell login.
# --platform  sprite: a Fly.io Sprite that pauses. none: a machine that never
#             pauses. The default is none.
# --cwd       the default directory for commands. The default is $HOME.
# --notify-dm when a job ends, send the result to its owner as a direct
#             message.
#
# The provider is the exec-provider binary next to the arc binary, where an
# ARC release installs it. Set EXEC_PROVIDER to use another binary.
set -eu

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

key='' relay='' platform=none cwd=$HOME notify_dm=0 grants=()
while [ $# -gt 0 ]; do
  case $1 in
    --key) key=$2; shift 2 ;;
    --relay) relay=$2; shift 2 ;;
    --grant) grants+=("$2"); shift 2 ;;
    --platform) platform=$2; shift 2 ;;
    --cwd) cwd=$2; shift 2 ;;
    --notify-dm) notify_dm=1; shift ;;
    *) usage ;;
  esac
done
[ -n "$key" ] && [ -n "$relay" ] && [ ${#grants[@]} -gt 0 ] || usage
case $platform in sprite | none) ;; *) echo "init: --platform must be sprite or none" >&2; exit 2 ;; esac
[[ $relay =~ ^wss?://[^/\"]+/?$ ]] || { echo "init: --relay must be a ws:// or wss:// URL" >&2; exit 2; }
for grant in "${grants[@]}"; do
  [[ $grant =~ ^[0-9a-f]{64}$ ]] || { echo "init: $grant is not 64 lowercase hex characters" >&2; exit 2; }
done
[[ $cwd = /* && -d $cwd && $cwd != *'"'* && $cwd != *'\'* ]] || { echo "init: --cwd must be an existing absolute directory" >&2; exit 2; }

here=$(cd "$(dirname "$0")/.." && pwd)
export PATH="$HOME/.local/bin:$PATH"
command -v arc >/dev/null || { echo "init: arc is not on the PATH" >&2; exit 1; }
public_key=$(arc --key "$key" whoami 2>/dev/null | sed -n 2p)
[[ $public_key =~ ^[0-9a-f]{64}$ ]] || { echo "init: no arc identity named $key" >&2; exit 1; }
arc --key "$key" relay add "$relay"

provider=${EXEC_PROVIDER:-$(dirname "$(readlink -f "$(command -v arc)")")/exec-provider}
[ -x "$provider" ] || { echo "init: $provider is not a program. Install ARC with install.sh, or set EXEC_PROVIDER." >&2; exit 1; }

# A wake hook runs with the environment of the caller, so citizen.env names
# the arc home of the citizen.
cat > "$here/citizen.env" <<ENV
ARC_HOME=${ARC_HOME:-$HOME/.config/arc}
ARC_KEY=$key
CITIZEN_RELAY=$relay
EXEC_CONFIG=$here/config.json
EXEC_PROVIDER=$provider
CITIZEN_PUBLIC_KEY=$public_key
CITIZEN_PLATFORM=$platform
ENV

grant_list=$(printf '"%s", ' "${grants[@]}")
lease=
if [ "$platform" != none ]; then
  lease=$(cat <<JSON
,
  "lease": {
    "hold": ["$here/citizen/lease", "hold", "300"],
    "release": ["$here/citizen/lease", "hold", "60"],
    "interval_ms": 60000
  }
JSON
)
fi
notify=
if [ "$notify_dm" = 1 ]; then
  notify=$(cat <<JSON
,
  "notify": {
    "argv": ["$here/citizen/notify-dm", "{owner}"]
  }
JSON
)
fi
cat > "$here/config.json" <<JSON
{
  "grants": [${grant_list%, }],
  "cwd": "$cwd"$lease$notify
}
JSON

echo "citizen $public_key"
echo "wrote $here/citizen.env and $here/config.json"
echo "start it with: $here/citizen/citizen-up"
