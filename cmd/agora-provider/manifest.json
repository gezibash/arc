{
  "published_at": "2026-09-15T00:00:00Z",
  "release": {"version": "0.1.0", "channel": "stable"},
  "capability": {
    "id": "primary",
    "kind": "data",
    "scheme": "agora",
    "title": "Agora",
    "summary": "A public board of signed ARC posts and threaded replies.",
    "invocation": {"method": "RAW", "path": "/"},
    "examples": ["post Hello republic", "feed", "reply <post-id> Welcome"]
  },
  "interfaces": {
    "cli": {
      "version": 4,
      "namespace": "agora",
      "commands": [
        {
          "path": ["post"],
          "summary": "Publish one signed public post.",
          "args": [{"name": "body", "kind": "positional", "required": true, "variadic": true, "description": "Post text"}],
          "input": {"source": "agora", "operation": "post", "body": "body"}
        },
        {
          "path": ["reply"],
          "summary": "Reply to one public post.",
          "args": [
            {"name": "id", "kind": "positional", "required": true, "description": "Parent post id"},
            {"name": "body", "kind": "positional", "required": true, "variadic": true, "description": "Reply text"}
          ],
          "input": {"source": "agora", "operation": "reply", "id": "id", "body": "body"}
        },
        {
          "path": ["read"],
          "summary": "Read one signed post.",
          "args": [{"name": "id", "kind": "positional", "required": true, "description": "Post id"}],
          "input": {"source": "agora", "operation": "read", "id": "id"}
        },
        {
          "path": ["feed"],
          "summary": "Read top-level posts in board acceptance order.",
          "args": [
            {"name": "after", "kind": "option", "flag": "--after", "type": "integer", "required": false, "description": "Continue after a board sequence"},
            {"name": "limit", "kind": "option", "flag": "--limit", "type": "integer", "required": false, "description": "Posts to return, 1 through 50"}
          ],
          "input": {"source": "agora", "operation": "feed", "after": "after", "limit": "limit"}
        },
        {
          "path": ["thread"],
          "summary": "Read direct replies to one post.",
          "args": [
            {"name": "id", "kind": "positional", "required": true, "description": "Parent post id"},
            {"name": "after", "kind": "option", "flag": "--after", "type": "integer", "required": false, "description": "Continue after a board sequence"},
            {"name": "limit", "kind": "option", "flag": "--limit", "type": "integer", "required": false, "description": "Replies to return, 1 through 50"}
          ],
          "input": {"source": "agora", "operation": "thread", "id": "id", "after": "after", "limit": "limit"}
        }
      ]
    }
  }
}
